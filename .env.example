# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/descomplica"

# Autenticação (JWT em cookie httpOnly)
JWT_SECRET="troque-por-um-segredo-aleatorio-bem-grande-em-producao"

# URL pública do site (usada em links de e-mail, Stripe success/cancel, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Número de WhatsApp para o botão flutuante (formato internacional, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# Storage S3 / MinIO (upload direto por URL assinada)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="descomplica-uploads"
# URL pública (via proxy/CDN ou o próprio endpoint do MinIO) usada para montar os links dos arquivos enviados
S3_PUBLIC_URL="http://localhost:9000/descomplica-uploads"

# Stripe (Checkout com cartão e Pix em BRL)
STRIPE_SECRET_KEY="sk_test_substitua_pela_chave_de_teste"
STRIPE_WEBHOOK_SECRET="whsec_substitua_pelo_segredo_do_webhook"
